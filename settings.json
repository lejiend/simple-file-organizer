    "Images": ["jpg", "jpeg", "png", "gif", "bmp", "svg", "webp", "heic", "heif", "tiff", "ico"],
    "Documents": ["pdf", "doc", "docx", "txt", "rtf", "odt", "md", "pages", "epub"],
    "Spreadsheets": ["xls", "xlsx", "csv", "ods", "numbers", "tsv"],
    "Presentations": ["ppt", "pptx", "key", "odp"],
    "Audio": ["mp3", "wav", "aac", "flac", "m4a", "ogg", "wma"],
    "Video": ["mp4", "mov", "avi", "mkv", "wmv", "flv", "webm", "m4v"],
    "Archives": ["zip", "rar", "7z", "tar", "gz", "bz2", "xz"],
    "Code": ["py", "js", "ts", "jsx", "tsx", "html", "css", "json", "java", "c", "cpp", "sh", "rb", "go", "php", "swift", "yml", "yaml"],
    "Installers": ["dmg", "pkg", "exe", "msi"]
